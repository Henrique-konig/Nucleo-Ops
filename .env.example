# Neon: URL com pooling (-pooler) para a aplicação
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.sa-east-1.aws.neon.tech/plantao?sslmode=require"
# Neon: URL direta (sem -pooler) para migrações e para o LISTEN do tempo real
DIRECT_URL="postgresql://user:pass@ep-xxx.sa-east-1.aws.neon.tech/plantao?sslmode=require"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET=""

# Chave para cifrar configurações de integração (32 bytes em base64) — openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=""

# Endereço público da aplicação (links de acompanhamento nos e-mails)
APP_URL="http://localhost:3000"

# Segredo das rotas de cron (/api/cron/*); a Vercel envia "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=""

# IA: com ANTHROPIC_API_KEY os agentes usam o Claude; sem ela, o provedor local
# (regras simples, sem custo). AI_PROVIDER=local força o provedor local.
ANTHROPIC_API_KEY=""
# AI_MODEL="claude-opus-5-5"
# Cotação para mostrar custos em reais
USD_BRL="5.40"

# Embeddings para busca semântica (Voyage AI). Sem chave, a busca usa texto completo.
VOYAGE_API_KEY=""

# Código exigido na tela de primeira configuração (/setup). Defina em produção.
SETUP_TOKEN=""

# E-mail de saída (avisos ao solicitante e ao responsável) sem cadastrar a
# integração em Administração > Integrações. Chave do Resend (resend.com) e
# remetente de um domínio verificado lá. Só EMAIL_FROM, sem chave, registra os
# e-mails no console (desenvolvimento).
RESEND_API_KEY=""
EMAIL_FROM=""

# Monitoramento de erros (Sentry). Sem DSN o monitoramento fica desligado.
# Crie um projeto Next.js em sentry.io e copie o DSN para as duas variáveis.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Opcional: envia source maps no build, para ver o código original nos erros.
# SENTRY_ORG="minha-org"
# SENTRY_PROJECT="plantao"
# SENTRY_AUTH_TOKEN=""
# Opcional: fração das requisições com rastreamento de desempenho (padrão 0.1).
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
