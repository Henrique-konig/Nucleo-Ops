# Neon: URL com pooling (-pooler) para a aplicação
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.sa-east-1.aws.neon.tech/plantao?sslmode=require"
# Neon: URL direta (sem -pooler) para migrações e para o LISTEN do tempo real
DIRECT_URL="postgresql://user:pass@ep-xxx.sa-east-1.aws.neon.tech/plantao?sslmode=require"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET=""

# Chave para cifrar configurações de integração (32 bytes em base64) — openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=""
